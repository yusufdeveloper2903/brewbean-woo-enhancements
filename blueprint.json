{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Brew & Bean – WooCommerce enhancements (local)",
		"description": "Local development blueprint. Expects the plugin to be mounted at wp-content/plugins/brewbean-woo-enhancements (see `npm run dev`).",
		"author": "Yusuf Yuldashev",
		"categories": [ "WooCommerce" ]
	},
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"login": true,
	"steps": [
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"WP_DEBUG": true,
				"WP_DEBUG_LOG": true,
				"WP_DEBUG_DISPLAY": false,
				"SCRIPT_DEBUG": false
			}
		},
		{
			"step": "installTheme",
			"themeData": { "resource": "wordpress.org/themes", "slug": "twentytwentyfive" },
			"options": { "activate": false },
			"ifAlreadyInstalled": "skip"
		},
		{
			"step": "installPlugin",
			"pluginData": { "resource": "wordpress.org/plugins", "slug": "woocommerce" },
			"options": { "activate": true },
			"ifAlreadyInstalled": "skip"
		},
		{
			"step": "activatePlugin",
			"pluginPath": "brewbean-woo-enhancements/brewbean-woo-enhancements.php"
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php'; require WP_PLUGIN_DIR . '/brewbean-woo-enhancements/demo/seed.php';"
		}
	]
}
